rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user can only read/write their own private TrainIQ data
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // Protect all subcollections dynamically under the user's document
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
